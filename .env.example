NODE_ENV="development"
PORT="3001"

# PostgreSQL. Railway provides this for API service when Postgres is attached.
DATABASE_URL="postgresql://manifestacije:manifestacije@localhost:5432/manifestacije?schema=public"

# Required in staging/production. Use a long random value.
JWT_SECRET="replace-with-long-random-secret"

# Anthropic Claude — used for AI-powered event parsing in admin.
# Get key at console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Cloudinary event image uploads.
# Koristi ili CLOUDINARY_URL (sve-u-jednom iz Cloudinary dashboarda) ili tri odvojena vara.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER="manifestacije/events"

# Comma-separated extra browser origins beyond localhost + production domains.
CORS_ALLOWED_ORIGINS=

# Google Places API — venue/location autocomplete in admin & organizer forms.
# Enable "Places API (New)" at console.cloud.google.com, then create + restrict an API key.
# Optional: falls back to free Nominatim (OpenStreetMap) search if unset, but Nominatim
# rarely knows business/venue names — only addresses.
GOOGLE_PLACES_API_KEY=

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Get it at analytics.google.com → Admin → Data streams → your web stream.
NEXT_PUBLIC_GA_ID=

# Seed admin. Staging may use documented defaults; production should override.
SEED_ADMIN_EMAIL="admin@manifestacije.test"
SEED_ADMIN_PASSWORD="replace-before-deploy"
SEED_DEMO_DATA="true"

# Public URLs. NEXT_PUBLIC_API_URL is API origin, without trailing /api.
# PUBLIC_WEB_URL is also used server-side by apps/api to build links in
# transactional emails (event/organizer/admin URLs) — must not be localhost
# or a Vercel preview URL in production.
PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# Transactional email (apps/api only — never exposed to apps/web).
# Resend handles outbound mail only; PrivateEmail remains the real inbox for
# info@manifestacije.hr and inbound receiving is not configured here.
# EMAIL_DELIVERY_MODE=log logs intended email metadata instead of sending —
# use this for local dev. Set to "resend" to actually send via Resend.
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_DELIVERY_MODE=log
EMAIL_FROM_NAME=Manifestacije.hr
EMAIL_FROM_ADDRESS=obavijesti@manifestacije.hr
EMAIL_REPLY_TO=info@manifestacije.hr
ADMIN_NOTIFICATION_EMAIL=info@manifestacije.hr

# Password reset link TTL and target page. If PASSWORD_RESET_URL is unset,
# the API falls back to `${PUBLIC_WEB_URL}/reset-password` — never hardcode
# a Vercel preview URL here.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_URL="http://localhost:3000/reset-password"