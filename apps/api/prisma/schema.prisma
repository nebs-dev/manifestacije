generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ORGANIZER
}

enum OrganizerStatus {
  UNCLAIMED
  CLAIMED
  VERIFIED
  TRUSTED
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum EventSourceType {
  EMAIL
  URL
  MANUAL
  SCRAPE_DISCOVERY
}

enum EventSourceStatus {
  NEW
  PARSED
  NEEDS_REVIEW
  LINKED
  REJECTED
}

enum EventSourceKind {
  MANUAL
  ORGANIZER_FORM
  EMAIL
  URL_SUBMISSION
  IMPORTED
}

enum DuplicateStatus {
  OPEN
  MERGED
  DISMISSED
}

enum IngestionJobType {
  EMAIL_PARSE
  URL_PARSE
  DUPLICATE_CHECK
  GEOCODE
}

enum IngestionJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum EmailContactSource {
  REGISTRATION
  EVENT_SUBMISSION
  SOURCE_SUBMISSION
  PROFILE_CLAIM
  EXISTING_ENGAGED_ORGANIZER_BACKFILL
}

enum EmailContactSyncStatus {
  PENDING
  SYNCED
  FAILED
  UNSUBSCRIBED
}

enum OrganizerClaimStatus {
  PENDING
  EMAIL_VERIFICATION_SENT
  NEEDS_ADMIN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
  EXPIRED
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String
  name               String
  role               UserRole
  organizerId        Int?
  organizer          Organizer? @relation(fields: [organizerId], references: [id])
  /// Incremented on password reset to invalidate all previously issued JWTs
  /// (JwtAuthGuard rejects tokens whose authVersion doesn't match this value).
  authVersion        Int       @default(0)
  passwordResetTokens PasswordResetToken[]
  emailContacts      EmailContact[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organizer {
  id           Int       @id @default(autoincrement())
  name         String
  slug         String    @unique
  description  String?
  websiteUrl   String?
  facebookUrl  String?
  instagramUrl String?
  email        String?
  phone        String?
  status       OrganizerStatus @default(UNCLAIMED)
  users        User[]
  events       Event[]
  sources      EventSource[]
  emailContacts EmailContact[]
  claims       OrganizerClaim[]
  adminViewedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrganizerClaim {
  id             Int                  @id @default(autoincrement())
  organizerId    Int
  email          String
  tokenHash      String?              @unique
  status         OrganizerClaimStatus @default(PENDING)
  expiresAt      DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  completedAt    DateTime?
  internalReason String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([email])
  @@index([status])
}

model EmailContact {
  id              Int                     @id @default(autoincrement())
  email           String                  @unique
  organizerId     Int?
  userId          Int?
  source          EmailContactSource
  resendContactId String?
  syncStatus      EmailContactSyncStatus  @default(PENDING)
  isUnsubscribed  Boolean                 @default(false)
  unsubscribedAt  DateTime?
  lastSyncedAt    DateTime?
  syncError       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organizer Organizer? @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizerId])
  @@index([userId])
  @@index([syncStatus])
}

model Region {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  counties  County[]
  events    Event[]
}

model County {
  id       Int      @id @default(autoincrement())
  name     String
  slug     String   @unique
  regionId Int
  region   Region   @relation(fields: [regionId], references: [id])
  cities   City[]
  events   Event[]
}

model City {
  id       Int      @id @default(autoincrement())
  name     String
  slug     String   @unique
  countyId Int
  county   County   @relation(fields: [countyId], references: [id])
  lat      Float?
  lng      Float?
  venues   Venue[]
  events   Event[]
}

model Venue {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String
  address   String?
  cityId    Int
  city      City     @relation(fields: [cityId], references: [id])
  lat       Float?
  lng       Float?
  source    String?
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([slug, cityId])
}

model Category {
  id         Int             @id @default(autoincrement())
  name       String
  slug       String          @unique
  parentId   Int?
  parent     Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]      @relation("CategoryTree")
  sortOrder  Int             @default(0)
  events     Event[]
  eventCats  EventCategory[]
}

model EventCategory {
  eventId    Int
  categoryId Int
  source     String?
  confidence Float?
  createdAt  DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
  @@index([categoryId])
  @@index([eventId])
}

model Partner {
  id         Int      @id @default(autoincrement())
  name       String
  logoUrl    String
  websiteUrl String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Event {
  id                   Int       @id @default(autoincrement())
  title                String
  slug                 String    @unique
  description          String
  status               EventStatus @default(PENDING_REVIEW)
  organizerId          Int?
  organizer            Organizer? @relation(fields: [organizerId], references: [id])
  venueId              Int?
  venue                Venue?    @relation(fields: [venueId], references: [id])
  cityName             String?
  cityId               Int?
  city                 City?     @relation(fields: [cityId], references: [id])
  countyId             Int?
  county               County?   @relation(fields: [countyId], references: [id])
  regionId             Int?
  region               Region?   @relation(fields: [regionId], references: [id])
  categoryId           Int
  category             Category  @relation(fields: [categoryId], references: [id])
  categories           EventCategory[]
  startsAt             DateTime
  endsAt               DateTime?
  isAllDay             Boolean   @default(false)
  isFree               Boolean?
  priceText            String?
  ticketUrl            String?
  sourceUrl            String?
  imageUrl             String?
  address              String?
  lat                  Float?
  lng                  Float?
  sourceType           EventSourceKind @default(MANUAL)
  extractionConfidence Float?
  isFeatured           Boolean   @default(false)
  publishedAt          DateTime?
  sources              EventSource[]
  duplicatesA          EventDuplicateCandidate[] @relation("DuplicateA")
  duplicatesB          EventDuplicateCandidate[] @relation("DuplicateB")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model EventSource {
  id              Int       @id @default(autoincrement())
  eventId         Int?
  event           Event?    @relation(fields: [eventId], references: [id])
  organizerId     Int?
  organizer       Organizer? @relation(fields: [organizerId], references: [id])
  type            EventSourceType
  sourceUrl       String?
  rawText         String?
  rawHtml         String?
  rawEmailSubject String?
  rawEmailFrom    String?
  rawEmailDate    DateTime?
  parsedJson      Json?
  confidence      Float?
  status          EventSourceStatus @default(NEW)
  adminViewedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EventDuplicateCandidate {
  id        Int      @id @default(autoincrement())
  eventAId  Int
  eventA    Event    @relation("DuplicateA", fields: [eventAId], references: [id])
  eventBId  Int
  eventB    Event    @relation("DuplicateB", fields: [eventBId], references: [id])
  score     Float
  reason    String
  status    DuplicateStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventAId, eventBId])
}

model IngestionJob {
  id        Int      @id @default(autoincrement())
  type      IngestionJobType
  status    IngestionJobStatus @default(QUEUED)
  payload   Json
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
